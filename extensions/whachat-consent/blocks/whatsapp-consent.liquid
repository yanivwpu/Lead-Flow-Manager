<div class="whachat-consent-host" data-whachat-consent data-placement="{{ block.settings.placement | default: 'content_end' | escape }}" {{ block.shopify_attributes }}>
  {% if request.design_mode %}
    <p role="status">{{ 'consent.preview' | t | escape }}</p>
  {% endif %}
  <noscript><p>{{ 'consent.javascript' | t | escape }}</p></noscript>
</div>
{% schema %}
{
  "name": "t:consent.name",
  "target": "body",
  "javascript": "consent.js",
  "stylesheet": "consent.css",
  "settings": [{ "type": "select", "id": "placement", "label": "t:consent.placement", "default": "content_end", "options": [{ "value": "content_end", "label": "t:consent.content_end" }, { "value": "original", "label": "t:consent.original" }] }]
}
{% endschema %}
